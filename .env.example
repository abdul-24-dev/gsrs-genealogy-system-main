# GSRS Environment Configuration
# PostgreSQL connection string (use the non-pooling URL for migrations)
DATABASE_URL="postgresql://user:password@host:5432/gsrs?schema=public"

# Session Security Secret
JWT_SECRET="gsrs-local-system-secret-key-change-me-if-needed-for-production"

# Application Settings
PORT=3000
NODE_ENV=development

# Storage Directories
UPLOAD_DIR="./storage/uploads"
BACKUP_DIR="./storage/backups"
